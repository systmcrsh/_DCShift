              {
                "box": {
                  "code": "// standard one-pole DC-blocking filter, R close to 1\r\nHistory xPrevL(0);\r\nHistory yPrevL(0);\r\nHistory xPrevR(0);\r\nHistory yPrevR(0);\r\n\r\nR = 0.9997;\r\n\r\nyL = in1 - xPrevL + R*yPrevL;\r\nxPrevL = in1;\r\nyPrevL = yL;\r\n\r\nyR = in2 - xPrevR + R*yPrevR;\r\nxPrevR = in2;\r\nyPrevR = yR;\r\n\r\n// in3 is the shift control: 0 = pure DC correction (no added offset),\r\n// value maps directly to the added offset -- positive shifts up, negative down\r\noutL = clip(yL + in3, -1, 1);\r\noutR = clip(yR + in3, -1, 1);\r\n\r\nout1 = outL;\r\nout2 = outR;\r\n",
                  "fontface": 0,
                  "fontname": "<Monospaced>",
                  "fontsize": 12.0,
                  "id": "obj-6",
                  "maxclass": "codebox",
                  "numinlets": 3,
                  "numoutlets": 2,
                  "outlettype": [
